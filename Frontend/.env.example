# ==========================================
# VetCloud Frontend Environment Variables
# ==========================================

# URL of your deployed backend server (e.g. on Render, Railway, Heroku, or VPS)
# IMPORTANT: Do not include a trailing slash (/)
VITE_BACKEND_URL=https://your-backend-api.onrender.com

# Google OAuth 2.0 Client ID (Required for Google Login)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
